{
  "name": "maratonei",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint apps packages eslint.config.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md}\" \"*.{json,mjs}\" pnpm-workspace.yaml",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,json,md}\" \"*.{json,mjs}\" pnpm-workspace.yaml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
