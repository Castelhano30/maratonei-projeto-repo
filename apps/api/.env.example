# Copie para .env e ajuste. Nunca versione valores reais.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Banco local: `pnpm --filter @maratonei/api db:up` sobe o Postgres do docker-compose (porta 5433).
# O app usa DATABASE_URL (em produção, a do pooler do Neon).
DATABASE_URL=postgresql://maratonei:maratonei@localhost:5433/maratonei
# As migrações usam DIRECT_URL (conexão direta, sem pooler). Local, pode ficar igual à DATABASE_URL.
DIRECT_URL=postgresql://maratonei:maratonei@localhost:5433/maratonei
# Origem do web: única aceita pelo CORS e pela checagem de Origin em métodos que mudam estado.
WEB_ORIGIN=http://localhost:3000
# Banco dos testes. Sem esta variável, os testes usam o do docker-compose (maratonei_test).
# TEST_DATABASE_URL=postgresql://maratonei:maratonei@localhost:5433/maratonei_test
