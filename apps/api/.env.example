# Copie para .env e ajuste. Nunca versione valores reais.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://usuario:senha@localhost:5432/maratonei
# Origem do web: única aceita pelo CORS e pela checagem de Origin em métodos que mudam estado.
WEB_ORIGIN=http://localhost:3000
# Só para os testes: com um Postgres de teste, o teste de /ready com banco real deixa de ser pulado.
# TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/maratonei_test
